{
  "name": "dsh-zipfix",
  "version": "0.4.0",
  "description": "ZIP 中文文件名乱码修复器（DeepSeek Harness 插件）：5 个 agent 工具 + 侧边栏上传面板。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "plugin/index.js",
    "plugin/lib",
    "plugin/locale",
    "ui/index.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zip",
    "filename",
    "gbk",
    "mojibake",
    "chinese",
    "cordis"
  ],
  "author": {
    "name": "zhibo0502",
    "url": "https://github.com/zhibo0502"
  },
  "homepage": "https://github.com/zhibo0502/dsh-zipfix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhibo0502/dsh-zipfix.git",
    "directory": "dist/dsh-zipfix"
  },
  "bugs": {
    "url": "https://github.com/zhibo0502/dsh-zipfix/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}

{
  "name": "dsh-zipfix-ui",
  "version": "0.1.2",
  "private": true,
  "description": "ZIP 中文文件名修复器的侧边栏 UI：上传 ZIP → 编码体检 → 生成可转发的修复版 ZIP 或按正确文件名解压到指定目录。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "zipfix",
    "sidebar",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "zhibo0502",
    "url": "https://github.com/zhibo0502"
  },
  "homepage": "https://github.com/zhibo0502/dsh-zipfix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhibo0502/dsh-zipfix.git",
    "directory": "dsh-zipfix-ui"
  },
  "bugs": {
    "url": "https://github.com/zhibo0502/dsh-zipfix/issues"
  }
}

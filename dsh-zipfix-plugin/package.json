{
  "name": "dsh-zipfix",
  "version": "0.3.0",
  "private": true,
  "description": "ZIP 中文文件名乱码修复器：嗅探 GBK/GB18030/Big5 文件名编码、按正确名字解压、生成置位 UTF-8 标志的修复版 ZIP、按 size+CRC32 与源包配对还原 U+FFFD 乱码，并用编码指纹验证反推名字。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "zip",
    "mojibake",
    "gbk",
    "filename"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
